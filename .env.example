# Credenciais exclusivamente locais de demonstração. Não use dados de produção.
DATABASE_URL="postgresql://postgres:demo_local_only@127.0.0.1:5432/portal_academico?schema=public"
DEMO_SESSION_SECRET="replace-with-a-local-random-value-at-least-32-characters"
NEXT_PUBLIC_APP_NAME="Portal Acordo Acadêmico"
NEXT_PUBLIC_DEMO_MODE="true"

# API de consulta CPF (configure no Netlify > Site configuration > Environment variables)
SNOOP_API_BASE_URL="https://snoopintelligence.cloud/api/v2"
SNOOP_API_TOKEN=""
# Opcional: fallback com múltiplos tokens separados por vírgula
SNOOP_API_TOKENS=""

# Chaves exclusivamente fictícias do módulo acadêmico Blackcat.
BLACKCAT_DEMO_PRIVATE_KEY="CHAVE_PRIVADA_FICTICIA_NAO_UTILIZAVEL"
BLACKCAT_DEMO_PUBLIC_KEY="CHAVE_PUBLICA_FICTICIA_NAO_UTILIZAVEL"
